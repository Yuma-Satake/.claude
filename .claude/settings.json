{
  "permissions": {
    "deny": [
      "Bash(git switch*)",
      "Bash(git checkout*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/hooks/suggest-gitignore-on-add.sh"
          }
        ]
      }
    ]
  }
}
