{
  "env": {
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "BASH_MAX_OUTPUT_LENGTH": "15000",
    "CLAUDE_AFK_TIMEOUT_MS": "1800000",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "400000"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [],
    "deny": [
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git clean:*)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "sonnet",
  "enableAllProjectMcpServers": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/herdr-agent-state.sh session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay -v 0.5 /System/Library/Sounds/Hero.aiff"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/check-knowledge-review-pending.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/detect-hallucinated-user-turn.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/set-knowledge-review-flag.sh",
            "if": "Bash(git commit *)"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__claude-in-chrome__.*",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"Chrome MCPツール使用時は必ずmcp-chromeスキル（~/.claude/skills/mcp-chrome/SKILL.md）を確認してから操作する\"}}'"
          }
        ]
      },
      {
        "matcher": "mcp__slack__.*",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"Slack MCPツール使用時は必ずmcp-slackスキル（~/.claude/skills/mcp-slack/SKILL.md）を確認してから操作する\"}}'"
          }
        ]
      },
      {
        "matcher": "mcp__notion__.*",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"Notion MCPツール使用時は必ずmcp-notionスキル（~/.claude/skills/mcp-notion/SKILL.md）を確認してから操作する\"}}'"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/inject-agent-use.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true,
    "datadog@claude-plugins-official": true,
    "discord@claude-plugins-official": false,
    "conference-organizing-knowledge-skill@conference-organizing-knowledge-skill": false,
    "cloudflare@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": true
  },
  "language": "japanese",
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "advisorModel": "claude-opus-5",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": false,
  "voiceEnabled": true
}
